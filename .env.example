# DJANGO
SECRET_KEY=

# Only 1/true/yes/on enable debug. Never enable it in production.
DEBUG=False
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Force HTTPS (redirect, HSTS, Secure cookies). Defaults to true when DEBUG is off.
# Requires a TLS reverse proxy forwarding X-Forwarded-Proto.
HTTPS_ONLY=

# HSTS duration in seconds when HTTPS_ONLY is on (default 31536000).
SECURE_HSTS_SECONDS=

# SameSite of the auth cookies: Lax (default), Strict, or None when the
# front-end is on another site than the API (requires HTTPS_ONLY).
AUTH_COOKIE_SAMESITE=

# Number of trusted reverse proxies in front of the API (default 1).
NUM_PROXIES=

# DATABASE
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
