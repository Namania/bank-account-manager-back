HTTPS_ONLY=
# HSTS duration in seconds when HTTPS_ONLY is on (default 31536000).
SECURE_HSTS_SECONDS=

# DATABASE
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
